#!/bin/sh
# Install root:root 0755. devmcp and mcp-tunnel must not be able to replace this.
# No arguments accepted, no tunnel credentials/environment inherited.
set -eu
test "$#" -eq 0 || exit 64
cd /opt/oci-dev-mcp
exec /usr/bin/env -i \
  HOME=/home/devmcp USER=devmcp LOGNAME=devmcp \
  PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 \
  OCI_DEV_STATE_DIR=/home/devmcp/.local/state/oci-dev-mcp \
  /usr/bin/node /opt/oci-dev-mcp/src/server.mjs
