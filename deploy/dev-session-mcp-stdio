#!/bin/sh
# Fixed same-UID launcher; edit the existing user's paths at installation.
set -eu
if test "$#" -ne 0; then
  printf 'This launcher takes no arguments.\n' >&2
  exit 64
fi
cd /home/ubuntu/projects
exec /usr/bin/env -i \
  HOME=/home/ubuntu USER=ubuntu LOGNAME=ubuntu \
  PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 \
  DEV_SESSION_MCP_STATE_DIR=/home/ubuntu/.local/state/dev-session-mcp-v3 \
  DEV_SESSION_MCP_FILE_ORIGINS= \
  /opt/dev-session-mcp/bin/dev-session-mcp stdio
