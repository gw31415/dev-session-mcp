[Unit]
Description=Persistent local-mcp development worker
After=network.target

[Service]
Type=simple
User=devmcp
Group=devmcp
WorkingDirectory=/opt/oci-dev-mcp
Environment=HOME=/home/devmcp
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=OCI_DEV_STATE_DIR=/home/devmcp/.local/state/oci-dev-mcp
Environment=OCI_DEV_DEFAULT_CWD=/home/devmcp/projects
Environment=OCI_DEV_LOCAL_MCP_BIN=/opt/oci-dev-mcp/bin/local-mcp
ExecStart=/usr/bin/node /opt/oci-dev-mcp/src/daemon.mjs
Restart=on-failure
RestartSec=3
UMask=0077
# tmux terminals deliberately survive worker replacement.
# local-mcp's ordinary jobs need the worker; prefer mux for restart durability.
KillMode=process
TimeoutStopSec=15
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
