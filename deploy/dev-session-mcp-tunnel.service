[Unit]
Description=dev-session-mcp via OpenAI Secure MCP Tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
Environment=PATH=/usr/local/bin:/usr/bin:/bin
LoadCredential=runtime-key:/etc/dev-session-mcp-tunnel/runtime-key
ExecStart=/usr/local/bin/tunnel-client run --config /etc/dev-session-mcp-tunnel/config.yaml --control-plane.api-key=file:%d/runtime-key
Restart=on-failure
RestartSec=5
UMask=0077
# Keep the independent broker alive when the Tunnel frontend is replaced.
KillMode=process
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
