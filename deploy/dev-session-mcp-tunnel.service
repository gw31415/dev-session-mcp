[Unit]
Description=dev-session-mcp via OpenAI Secure MCP Tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp-tunnel
Group=mcp-tunnel
Environment=HOME=/var/lib/mcp-tunnel
Environment=PATH=/usr/local/bin:/usr/bin:/bin
LoadCredential=runtime-key:/etc/dev-session-mcp-tunnel/runtime-key
ExecStart=/usr/local/bin/tunnel-client run --config /etc/dev-session-mcp-tunnel/config.yaml --control-plane.api-key=file:%d/runtime-key
Restart=on-failure
RestartSec=5
UMask=0077
# The private PTY holder must survive Tunnel/Rust child replacement. Stop jobs explicitly.
KillMode=process
StandardOutput=journal
StandardError=journal
# Do not enable NoNewPrivileges here: the fixed sudo UID transition needs it off.

[Install]
WantedBy=multi-user.target
