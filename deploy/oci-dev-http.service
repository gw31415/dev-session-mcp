[Unit]
Description=OAuth-protected Rust development MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=devmcp
Group=devmcp
WorkingDirectory=/home/devmcp/projects
Environment=HOME=/home/devmcp
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=OCI_DEV_STATE_DIR=/home/devmcp/.local/state/oci-dev-mcp
Environment=OCI_DEV_DEFAULT_CWD=/home/devmcp/projects
ExecStart=/opt/oci-dev-mcp/bin/oci-dev-mcp serve --config /etc/oci-dev-mcp/http.json
Restart=on-failure
RestartSec=3
UMask=0077
# tmux terminals deliberately survive MCP process replacement.
KillMode=process
TimeoutStopSec=15
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
