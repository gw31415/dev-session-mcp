config_version: 1
control_plane:
  tunnel_id: REPLACE_WITH_EXISTING_TUNNEL_ID
# Runtime key supplied exclusively via LoadCredential + file: flag in systemd.
mcp:
  commands:
    - channel: main
      command: /usr/bin/sudo -n -u devmcp -- /usr/local/libexec/oci-dev-rust-stdio
  max_concurrent_requests: 4
health:
  listen_addr: 127.0.0.1:8080
log:
  level: info
  format: json
